{
  "name": "robinmwaniki/student-finance-manager",
  "type": "project",
  "description": "Personal finance management with Laravel and PostgreSQL.",
  "license": "proprietary",
  "require": {
    "php": "^8.5",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^3.0",
    "sentry/sentry-laravel": "^4.28"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\\\": "app/",
      "Database\\\\Factories\\\\": "database/factories/",
      "Database\\\\Seeders\\\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php artisan test",
    "lint": "@php vendor/bin/pint --test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}