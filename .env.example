APP_NAME="Student Finance Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Africa/Nairobi

LOG_CHANNEL=stack
# Container platforms such as Render collect stderr; keep Laravel exceptions visible there.
LOG_STACK=stderr
LOG_LEVEL=debug
PERFORMANCE_SLOW_REQUEST_THRESHOLD_MS=1000
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=
AI_TIMEOUT=8
AI_CONNECT_TIMEOUT=3
ALPHA_VANTAGE_API_KEY=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=student_finance
DB_USERNAME=student_finance
DB_PASSWORD=change-this-password
DB_SSLMODE=prefer

# Local defaults. For multi-instance hosting, provision private Redis first,
# then set SESSION_DRIVER=redis, CACHE_STORE=redis and QUEUE_CONNECTION=redis.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_CONNECTION=session

CACHE_STORE=file
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_BLOCK_FOR=5

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
FILESYSTEM_DISK=local
